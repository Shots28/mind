{
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron-schedule-calls",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron-retry-calls",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron-renew-watches",
      "schedule": "0 */6 * * *"
    }
  ]
}
